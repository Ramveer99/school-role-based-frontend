# Express API
# PORT=8787
# API_PORT=8787

# Local dev: proxy /api to backend
VITE_API_PROXY=http://localhost:8787
# Leave empty for production builds (same-origin /api/... when Express serves dist)
VITE_API_BASE_URL=

# MongoDB Atlas (never expose in frontend)
# Use database name school_dashboard — NOT school-saas (different schema).
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/school_dashboard
# Atlas example (replace user, password, cluster):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/school_dashboard?retryWrites=true&w=majority

# JWT (server only)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional CORS (comma-separated origins, or leave unset for dev reflection)
# CORS_ORIGIN=http://localhost:5173

# Supabase migration only (optional — copies data into MongoDB)
# npm run migrate:supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Upgrade old MongoDB auth (password on profiles → users collection)
# npm run upgrade:legacy-auth

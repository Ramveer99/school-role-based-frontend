{
  "name": "vite-react-js-fullstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "npm --prefix school-role-based-backend run dev",
    "start:api": "npm --prefix school-role-based-backend start",
    "seed": "npm --prefix school-role-based-backend run seed",
    "migrate:supabase": "npm --prefix school-role-based-backend run migrate:supabase",
    "upgrade:legacy-auth": "npm --prefix school-role-based-backend run upgrade:legacy-auth",
    "normalize:users": "npm --prefix school-role-based-backend run normalize:users",
    "build": "vite build && node scripts/sync-backend-dist.mjs",
    "start:frontend": "node scripts/serve-frontend.mjs",
    "start:prod": "npm run build && pm2 startOrRestart ecosystem.config.cjs",
    "serve": "npm run build && npm run start:api",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "serve": "^14.2.6",
    "vite": "^7.3.1"
  }
}
